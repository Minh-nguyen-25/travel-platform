# URL gốc của Backend API
# Không được commit file .env thật lên GitHub
VITE_API_URL=http://localhost:3000/api/v1

# Optional: real raster tile providers. Custom URLs require their own attribution.
# Defaults: OpenStreetMap France/HOT, then OpenStreetMap standard.
# VITE_MAP_TILE_URL=https://a.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=
# VITE_MAP_FALLBACK_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_FALLBACK_TILE_ATTRIBUTION=
VITE_MAP_TILE_TIMEOUT_MS=8000
