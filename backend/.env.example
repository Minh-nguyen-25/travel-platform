# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (PostgreSQL qua Docker) ─────────────────────────────────────────
# Cổng 5433 để tránh xung đột với PostgreSQL local trên Windows
DATABASE_URL="postgresql://travel_user:travel_password@127.0.0.1:5433/travel_db?schema=public"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Legacy keys — kept for teammates not yet on the auth branch
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=use_a_different_long_random_secret_in_production
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Production: luôn bật Secure; local HTTP có thể đặt false.
COOKIE_SECURE=false
REFRESH_COOKIE_NAME=travel_refresh_token
COOKIE_DOMAIN=

# New keys required by the auth module (add these to your local .env)
JWT_ACCESS_SECRET=your_access_token_secret_change_this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_must_differ_from_access
JWT_REFRESH_EXPIRES_IN=30d

# ─── Redis ────────────────────────────────────────────────────────────────────
# Docker port 6380 → container 6379 (see docker-compose.yml)
REDIS_URL=redis://127.0.0.1:6380

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:5173/login
GOOGLE_OAUTH_FAILURE_REDIRECT=http://localhost:5173/login?oauth=failed

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Chọn MỘT trong hai cách dưới đây. Không commit thông tin thật lên Git.
# Cách 1: dán API Environment variable lấy từ Cloudinary Console
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Cách 2: khai báo riêng từng giá trị
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── AI sinh lịch trình (chọn openai hoặc gemini) ─────────────────────────────
AI_PROVIDER=openai

# Khóa mẫu; thay bằng khóa thật trong .env và không commit khóa thật
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
OPENAI_PROJECT=

GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Bỏ comment và đặt giá trị để ghi đè model riêng của provider đang chọn
# AI_MODEL=your_model_override
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=0
AI_MAX_OUTPUT_TOKENS=12000
AI_MAX_DESTINATION_CANDIDATES=60
AI_ROUTING_ENABLED=true
AI_MAX_ROUTING_LEGS=12
AI_ROUTING_CONCURRENCY=2
AI_ROUTING_DEADLINE_MS=15000
# Khóa HMAC riêng cho bản nháp AI; để trống sẽ fallback sang JWT_SECRET
AI_DRAFT_SECRET=
AI_DRAFT_PROOF_EXPIRES_IN=30m

# ─── Bản đồ / định tuyến OSRM ─────────────────────────────────────────────────
# OSRM public không cần API key; production nên dùng instance/provider riêng
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_REQUEST_TIMEOUT_MS=10000
OSRM_MAX_RETRIES=1
OSRM_API_KEY=
OSRM_API_KEY_QUERY_PARAM=api_key
OSRM_USER_AGENT=travel-platform-backend/1.0
OSRM_DRIVING_PROFILE=driving
OSRM_WALKING_PROFILE=walking
OSRM_CYCLING_PROFILE=cycling

# Để trống để từ chối TRANSIT; hoặc chọn driving, walking, cycling để xấp xỉ
OSRM_TRANSIT_FALLBACK_PROFILE=

# ─── Frontend URL (CORS) ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Database Seed ────────────────────────────────────────────────────────────
# Mật khẩu demo cho 8 tài khoản demo (demo.an@example.com, ...). Chỉ dùng cho local dev/test.
SEED_DEMO_PASSWORD=change-me-for-local-development
