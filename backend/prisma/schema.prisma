generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. users — Người dùng
model User {
  id               Int               @id @default(autoincrement())
  fullName         String            @map("full_name") @db.VarChar(100)
  email            String            @unique @db.VarChar(255)
  passwordHash     String?           @map("password_hash") @db.VarChar(255)
  authProvider     String            @default("LOCAL") @map("auth_provider") @db.VarChar(20)
  providerId       String?           @map("provider_id") @db.VarChar(255)
  avatarUrl        String?           @map("avatar_url") @db.Text
  role             String            @default("USER") @db.VarChar(20)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamp()
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  reviews          Review[]
  favorites        Favorite[]
  trips            Trip[]
  travelPreference TravelPreference? // Quan hệ 1-1
  refreshTokens     RefreshToken[]

  @@unique([authProvider, providerId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamp()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp()

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// 2. categories — Danh mục du lịch
model Category {
  id           Int                   @id @default(autoincrement())
  name         String                @unique @db.VarChar(100)
  description  String?               @db.Text
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  destinations DestinationCategory[]

  @@map("categories")
}

// 3. destinations — Địa điểm du lịch
model Destination {
  id               Int                   @id @default(autoincrement())
  name             String                @db.VarChar(200)
  description      String?               @db.Text
  address          String                @db.Text
  phoneNumber      String?               @map("phone_number") @db.VarChar(20)
  latitude         Decimal               @db.Decimal(10, 7)
  longitude        Decimal               @db.Decimal(10, 7)
  ticketPrice      Decimal               @default(0) @map("ticket_price") @db.Decimal(12, 2)
  openingHoursNote String?               @map("opening_hours_note") @db.Text
  visitDuration    Int?                  @map("visit_duration")
  rating           Decimal               @default(0) @db.Decimal(2, 1)
  isActive         Boolean               @default(true) @map("is_active")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamp()
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  categories       DestinationCategory[]
  images           DestinationImage[]
  reviews          Review[]
  favorites        Favorite[]
  itineraries      Itinerary[]

  @@map("destinations")
}

// 4. destination_categories — Quan hệ địa điểm và danh mục (N - N)
model DestinationCategory {
  destinationId Int         @map("destination_id")
  categoryId    Int         @map("category_id")

  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([destinationId, categoryId])
  @@map("destination_categories")
}

// 5. destination_images — Hình ảnh địa điểm
model DestinationImage {
  id            Int         @id @default(autoincrement())
  destinationId Int         @map("destination_id")
  imageUrl      String      @map("image_url") @db.Text
  isPrimary     Boolean     @default(false) @map("is_primary")
  displayOrder  Int         @default(0) @map("display_order")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamp()

  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@map("destination_images")
}

// 6. reviews — Đánh giá địa điểm
model Review {
  id            Int           @id @default(autoincrement())
  userId        Int           @map("user_id")
  destinationId Int           @map("destination_id")
  rating        Int           @db.SmallInt // Ràng buộc 1-5 sao sẽ được xử lý ở tầng logic (Backend)
  comment       String?       @db.Text
  isVisible     Boolean       @default(true) @map("is_visible")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp()
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination   @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  images        ReviewImage[]

  @@unique([userId, destinationId])
  @@map("reviews")
}

// 7. review_images — Hình ảnh đính kèm đánh giá
model ReviewImage {
  id        Int      @id @default(autoincrement())
  reviewId  Int      @map("review_id")
  imageUrl  String   @map("image_url") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()

  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_images")
}

// 8. favorites — Địa điểm yêu thích
model Favorite {
  userId        Int         @map("user_id")
  destinationId Int         @map("destination_id")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamp()

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([userId, destinationId])
  @@map("favorites")
}

// 9. trips — Chuyến đi
model Trip {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  name            String    @db.VarChar(200)
  destinationCity String    @map("destination_city") @db.VarChar(100)
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  budget          Decimal?  @db.Decimal(12, 2)
  numberOfPeople  Int       @default(1) @map("number_of_people")
  description     String?   @db.Text
  isAiGenerated   Boolean   @default(false) @map("is_ai_generated")
  aiRawData       String?   @map("ai_raw_data") @db.Text
  shareToken      String?   @unique @map("share_token") @db.VarChar(64)
  isPublic        Boolean   @default(false) @map("is_public")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripDays        TripDay[]

  @@map("trips")
}

// 10. trip_days — Các ngày trong chuyến đi
model TripDay {
  id          Int         @id @default(autoincrement())
  tripId      Int         @map("trip_id")
  dayNumber   Int         @map("day_number")
  date        DateTime    @db.Date
  note        String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamp()
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraries Itinerary[]

  @@unique([tripId, dayNumber])
  @@map("trip_days")
}

// 11. itineraries — Chi tiết lịch trình
model Itinerary {
  id                    Int         @id @default(autoincrement())
  tripDayId             Int         @map("trip_day_id")
  destinationId         Int         @map("destination_id")
  sequenceOrder         Int         @map("sequence_order")
  startTime             DateTime?   @map("start_time") @db.Time
  endTime               DateTime?   @map("end_time") @db.Time
  estimatedCost         Decimal     @default(0) @map("estimated_cost") @db.Decimal(12, 2)
  travelDistanceKm      Decimal?    @map("travel_distance_km") @db.Decimal(6, 2)
  travelDurationMinutes Int?        @map("travel_duration_minutes")
  travelMode            String?     @map("travel_mode") @db.VarChar(30)
  note                  String?     @db.Text
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamp()
  updatedAt             DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  tripDay               TripDay     @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  destination           Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([tripDayId, sequenceOrder])
  @@map("itineraries")
}

// 12. travel_preferences — Sở thích du lịch (Cá nhân hóa)
model TravelPreference {
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique @map("user_id")
  budgetLevel         String?  @map("budget_level") @db.VarChar(20)
  travelStyle         String?  @map("travel_style") @db.VarChar(50)
  preferredActivities Json?    @map("preferred_activities")
  preferredCategories Json?    @map("preferred_categories")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("travel_preferences")
}
